# Bonito API credentials
BONITO_URL=https://api.getbonito.com
# Use a scoped Bonito personal/project token. Do not use a full account password.
BONITO_API_TOKEN=bp-your-scoped-token

# Bulletproof demo project (already created on Bonito prod)
PROJECT_ID=b0bcd4b2-c667-4b98-8edb-48924d364e74

# Agent IDs (populated by setup/provision.py)
TRIAGE_ROUTER_ID=
PASSWORD_SPECIALIST_ID=
CONNECTIVITY_SPECIALIST_ID=
SOFTWARE_SPECIALIST_ID=
GENERAL_SUPPORT_ID=

# Optional local Halo mock server for frontend/API write-back tests.
# Bonito prod agents cannot reach localhost, so agent prompts do not call this directly.
HALO_MOCK_URL=http://localhost:8090
